# 复制为 .env 后按需修改：cp .env.example .env
# 该文件被 .gitignore 忽略，不会进入版本库

# ===== 身份 =====
# 邮件服务器主机名，必须与 DNS A 记录、证书 CN/SAN、Stalwart 内配置的 hostname 完全一致
MAIL_HOST=mail.example.com
# 主邮件域（收件地址 @ 后面的部分）
MAIL_DOMAIN=example.com
# 首个管理员邮箱（向导里创建）
ADMIN_MAIL=admin@example.com

TZ=Asia/Shanghai

# ===== 后端容器 =====
# 固定大版本，避免 latest 跨大版本升级导致的数据迁移问题
STALWART_TAG=v1
# 2G 服务器的内存上限；若机器更大可调到 1536m
STALWART_MEM_LIMIT=1g
# 首次 setup 用的临时管理员口令，格式 admin:你的密码
# setup 完成后请清空并重启容器
STALWART_RECOVERY_ADMIN=
# 恢复模式（临时排障）：置 1 后只开 8080 明文监听器且暂停 auto-ban/限流，
# 用于 IP 被封死或配置写坏时进后台修复；修完必须清空并重启
STALWART_RECOVERY_MODE=

# ===== 可选：出口中继（出站 25 被封时使用，见 docs/dns-and-deliverability.md 第 4 节） =====
# 这一段只是字段记录位：容器不读取它，Stalwart v1 的中继路由存在数据库里，
# 要填在管理后台 Settings › MTA › Outbound › Routes（类型 Relay）。
# 以腾讯云 SES 为例：host=smtp.qcloudmail.com，port=465（隐式 TLS，不是 STARTTLS）
# SMTP_RELAY_USER 必须是控制台「发信地址」；SMTP_RELAY_PASS 是该地址单独设置的 SMTP 密码，
# 不是腾讯云登录密码，也不是 API SecretKey。真实口令不要写进本文件或版本库。
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=465
SMTP_RELAY_TLS=implicit
SMTP_RELAY_USER=
SMTP_RELAY_PASS=

# ===== 可选：PostgreSQL（默认不启用，见 docker-compose.yml 注释） =====
POSTGRES_PASSWORD=
POSTGRES_MEM_LIMIT=256m

# ===== 前端部署 =====
# Nginx 托管的站点根目录（deploy-frontend.sh 会把 dist 发布到这里）
FRONTEND_SITE_DIR=/var/www/mail
FRONTEND_DOMAIN=mail.example.com
