# 复制为 .env.local 使用（该文件不进版本库）

# 路由模式：hash（默认，可省略）| history
#   hash    → 地址形如 /#/mail/inbox，路径全在 # 之后，任何静态托管刷新都不会 404
#   history → 地址形如 /mail/inbox，URL 更干净，但 Nginx 必须把未命中的路径回退到 index.html：
#             location / { try_files $uri $uri/ /index.html; }
# VITE_ROUTER_MODE=hash

# 本地开发是否使用内置模拟数据（默认开启，无需后端也能看界面）
# 设成 false 就切回真实后端，请求经下面的 Vite 代理转发
# VITE_USE_MOCK=false

# 开发期 Vite 代理的后端地址
# 本地 docker-compose.local.yml 把容器的 443 映射到 8443
VITE_PROXY_TARGET=https://127.0.0.1:8443

# 后端 JMAP 路径。保持相对路径，生产由 Nginx 同源反代
VITE_JMAP_PATH=/jmap/

# 登录页展示的服务器主机名
VITE_MAIL_HOST=mail.example.com
